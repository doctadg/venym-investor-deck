</div><!-- /slider -->
</div><!-- /viewport -->

<script>
const TOTAL = 10;
const slider = document.getElementById('slider');
const viewport = document.getElementById('viewport');
const progress = document.getElementById('progress');
const counter = document.getElementById('counter');
const dotsEl = document.getElementById('dots');
let current = 0;
let vw = window.innerWidth;

// Build dots
for(let i=0;i<TOTAL;i++){
  const d = document.createElement('div');
  d.className = 'dot' + (i===0?' active':'');
  d.onclick = ()=> go(i);
  dotsEl.appendChild(d);
}
const dots = dotsEl.querySelectorAll('.dot');

function size(){
  vw = window.innerWidth;
  slider.style.width = (vw * TOTAL) + 'px';
  const slides = slider.querySelectorAll('.slide');
  slides.forEach(s => s.style.width = vw + 'px');
  slider.style.transition = 'none';
  slider.style.transform = `translateX(-${current * vw}px)`;
  slider.offsetHeight; // reflow
  slider.style.transition = 'transform .6s cubic-bezier(.77,0,.175,1)';
}
size();
window.addEventListener('resize', size);

function go(n){
  if(n<0) n=0;
  if(n>=TOTAL) n=TOTAL-1;
  current = n;
  slider.style.transform = `translateX(-${current * vw}px)`;
  progress.style.width = ((current+1)/TOTAL*100)+'%';
  counter.textContent = String(current+1).padStart(2,'0') + ' / ' + String(TOTAL).padStart(2,'0');
  dots.forEach((d,i)=> d.className = 'dot'+(i===current?' active':''));
}

// Keyboard
document.addEventListener('keydown', e => {
  if(e.key==='ArrowRight'||e.key==='ArrowDown'||e.key===' '){e.preventDefault();go(current+1)}
  if(e.key==='ArrowLeft'||e.key==='ArrowUp'){e.preventDefault();go(current-1)}
  if(e.key==='Home'){e.preventDefault();go(0)}
  if(e.key==='End'){e.preventDefault();go(TOTAL-1)}
});

// Mouse wheel (debounced)
let wheelLock = false;
document.addEventListener('wheel', e => {
  if(wheelLock) return;
  // Check if scrollable content inside slide
  const slide = slider.children[current];
  const scrollable = slide.querySelector('[style*="overflow"]');
  if(scrollable){
    const atTop = scrollable.scrollTop <= 0;
    const atBottom = scrollable.scrollTop + scrollable.clientHeight >= scrollable.scrollHeight - 2;
    if(e.deltaY < 0 && !atTop) return;
    if(e.deltaY > 0 && !atBottom) return;
  }
  wheelLock = true;
  if(e.deltaY > 0) go(current+1);
  else if(e.deltaY < 0) go(current-1);
  setTimeout(()=> wheelLock=false, 800);
}, {passive:true});

// Touch/swipe
let touchX=0, touchY=0, touchActive=false;
document.addEventListener('touchstart', e => {
  touchX = e.touches[0].clientX;
  touchY = e.touches[0].clientY;
  touchActive = true;
}, {passive:true});
document.addEventListener('touchmove', e => {
  if(!touchActive) return;
  const dx = e.touches[0].clientX - touchX;
  const dy = e.touches[0].clientY - touchY;
  if(Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 10){
    e.preventDefault();
  }
}, {passive:false});
document.addEventListener('touchend', e => {
  if(!touchActive) return;
  touchActive = false;
  const dx = e.changedTouches[0].clientX - touchX;
  const dy = e.changedTouches[0].clientY - touchY;
  if(Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 60){
    if(dx < 0) go(current+1);
    else go(current-1);
  }
}, {passive:true});

// Init
go(0);
</script>

</body>
</html>